{
  "version": 8,
  "name": "AirTrail Earth Satellite",
  "metadata": {"maputnik:renderer": "mbgljs"},
  "sources": {
    "bm": {
      "type": "raster",
      "tiles": [
        "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/{z}/{y}/{x}.jpeg"
      ],
      "tileSize": 256,
      "maxzoom": 8,
      "attribution": "Imagery: NASA GIBS / Blue Marble"
    },
    "ofm": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"}
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#4a5a3c"}
    },
    {
      "id": "bluemarble",
      "type": "raster",
      "source": "bm",
      "paint": {
        "raster-opacity": ["interpolate", ["linear"], ["zoom"], 7, 1, 10.5, 0],
        "raster-saturation": 0.4,
        "raster-contrast": 0.3,
        "raster-brightness-max": 1,
        "raster-fade-duration": 0,
        "raster-brightness-min": 0.28
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "ofm",
      "source-layer": "landcover",
      "paint": {
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 9.5, 1],
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#1e3b26",
          "grass",
          "#33502e",
          "farmland",
          "#434f2b",
          "sand",
          "#6b5c38",
          "rock",
          "#524d43",
          "ice",
          "#b4c3cc",
          "wetland",
          "#254a40",
          "#2d3625"
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "ofm",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": [
        "match",
        ["get", "class"],
        [
          "residential",
          "suburb",
          "neighbourhood",
          "commercial",
          "industrial",
          "retail"
